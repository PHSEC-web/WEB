{
  "name": "psec-experiment-database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:repair-evidence": "node scripts/repair-evidence-schema.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "ali-oss": "^6.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "html2canvas-pro": "^2.4.5",
    "jose": "6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.24.4",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/ali-oss": "^6.23.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "@babel/core": "7.29.6",
      "baseline-browser-mapping": "2.11.0",
      "browserslist": "4.28.7",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "nanoid@3": "3.3.18",
      "picomatch": "4.0.4",
      "postcss": "8.5.23",
      "qs": "6.16.0",
      "rollup": "4.59.0"
    }
  }
}
